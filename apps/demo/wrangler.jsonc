{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Hosts the example app (apps/demo) as a static site at demo.mock-oidc.mvd.im. The mock provider,
  // including its authorize and end session pages, runs in the browser with
  // the MSW worker, so there is no Worker script.
  "name": "mock-oidc-demo",
  "compatibility_date": "2026-11-04",
  "assets": {
    // Built by `pnpm run build` in apps/demo.
    "directory": "./dist",
    // `/oidc-spa` redirects to `/oidc-spa/`, which serves its index.html.
    "html_handling": "auto-trailing-slash",
    // Unknown paths serve the example index, as the dev server does. That
    // includes the authorize URL when it is opened before the MSW worker runs.
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "demo.mock-oidc.mvd.im", "custom_domain": true }],
  // Settings for branch Previews (`wrangler preview`). Previews do not inherit
  // production settings; `assets` and `compatibility_date` stay top level, and
  // the site needs no variables or bindings, so the block is empty.
  "previews": {}
}
